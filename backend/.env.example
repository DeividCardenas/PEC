# ===== CONFIGURACIÓN DE BASE DE DATOS =====
# MySQL (desarrollo local)
DATABASE_URL_LOCAL=mysql://root:YOUR_STRONG_PASSWORD@localhost:3306/PEC

# PostgreSQL (producción con Docker)
DATABASE_URL_DOCKER=postgresql://postgres:YOUR_STRONG_PASSWORD@pec_db:5432/pec?schema=public

# ===== SEGURIDAD Y AUTENTICACIÓN =====
# Clave secreta para encriptación AES (usar 32 caracteres aleatorios)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_AES_SECRET_KEY=GENERATE_A_RANDOM_32_CHARACTER_KEY_HERE

# Clave secreta para firma de JWT (usar 32 caracteres aleatorios)
AUTH_JW_SECRET_KEY=GENERATE_ANOTHER_RANDOM_32_CHAR_KEY

# ===== CONFIGURACIÓN DEL SERVIDOR =====
# Puerto del servidor
PORT=2000

# Entorno (development | production | test)
NODE_ENV=development

# ===== CORS =====
# Origins permitidos (separados por coma, sin espacios)
# En desarrollo usar: http://localhost:3000
# En producción usar dominio real: https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# ===== POSTGRESQL ADMIN (pgAdmin) =====
PGADMIN_DEFAULT_EMAIL=admin@yourdomain.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ===== NOTAS DE SEGURIDAD =====
# ⚠️ NUNCA subir este archivo con valores reales al repositorio
# ⚠️ Usar contraseñas fuertes con al menos 16 caracteres
# ⚠️ Generar claves secretas aleatorias para AES y JWT
# ⚠️ En producción, configurar NODE_ENV=production
# ⚠️ En producción, especificar ALLOWED_ORIGINS con dominios reales

# ===== GENERACIÓN DE CLAVES SEGURAS =====
# Para generar claves secretas seguras ejecutar en terminal:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
