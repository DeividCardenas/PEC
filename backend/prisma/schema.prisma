// Prisma schema con documentación de modelos y relaciones

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL_LOCAL")
}

/// Modelo que representa a los usuarios del sistema
model Usuario {
  id_usuario Int    @id @default(autoincrement()) @map("id_usuario") // Identificador único del usuario
  username   String @unique @map("nombre_usuario")                   // Nombre de usuario único
  email      String @unique                                          // Correo electrónico único
  password   String                                                  // Contraseña encriptada
  id_rol     Int    @map("rol_id")                                   // ID del rol asociado
  rol        Rol    @relation(fields: [id_rol], references: [id_rol], onDelete: Cascade) // Relación con el rol

  ordenes_creadas     OrdenCompra[] @relation("OrdenesCreadas")        // Órdenes de compra creadas por el usuario
  ordenes_aprobadas   OrdenCompra[] @relation("OrdenesAprobadas")     // Órdenes de compra aprobadas por el usuario
  movimientos_inventario MovimientoInventario[]                       // Movimientos de inventario realizados
  historial_ordenes   HistorialOrdenCompra[]                          // Cambios de estado realizados (RF004)
  entregas_creadas    Entrega[] @relation("EntregasCreadas")          // Entregas creadas por el usuario (RF008)
  entregas_despachadas Entrega[] @relation("EntregasDespachadas")     // Entregas despachadas por el usuario (RF008)
  rutas_creadas       Ruta[] @relation("RutasCreadas")                // Rutas creadas por el usuario (RF009)

  createdAt DateTime @default(now()) @map("fecha_creacion")         // Fecha de creación
  updatedAt DateTime @updatedAt @map("fecha_actualizacion")         // Fecha de última actualización
}

/// Modelo que representa los distintos roles de usuario
model Rol {
  id_rol   Int            @id @default(autoincrement()) @map("id_rol") // Identificador del rol
  nombre   String         @unique                                      // Nombre del rol (único)
  permisos PermisoOnRol[]                                              // Relación con permisos
  usuarios Usuario[]                                                   // Relación con usuarios

  createdAt DateTime @default(now()) @map("fecha_creacion")
  updatedAt DateTime @updatedAt @map("fecha_actualizacion")
}

/// Modelo que representa los permisos del sistema
model Permiso {
  id_permiso Int                  @id @default(autoincrement()) @map("id_permiso") // ID del permiso
  nombre     String               @unique                                           // Nombre único del permiso
  roles      PermisoOnRol[]                                                         // Relación con roles
  tarifarios PermisoOnTarifario[]                                                   // Relación con tarifarios

  createdAt DateTime @default(now()) @map("fecha_creacion")
  updatedAt DateTime @updatedAt @map("fecha_actualizacion")
}

/// Modelo intermedio para la relación muchos-a-muchos entre Rol y Permiso
model PermisoOnRol {
  id_rol     Int      @map("rol_id")
  id_permiso Int      @map("permiso_id")
  rol        Rol      @relation(fields: [id_rol], references: [id_rol], onDelete: Cascade)
  permiso    Permiso  @relation(fields: [id_permiso], references: [id_permiso], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("fecha_creacion")
  updatedAt  DateTime @updatedAt @map("fecha_actualizacion")

  @@id([id_rol, id_permiso])
}

/// Modelo intermedio para relacionar Tarifarios con Permisos
model PermisoOnTarifario {
  id_permiso   Int       @map("permiso_id")
  id_tarifario Int       @map("tarifario_id")
  descripcion  String                                           // Descripción del permiso aplicado
  permiso      Permiso   @relation(fields: [id_permiso], references: [id_permiso], onDelete: Cascade)
  tarifario    Tarifario @relation(fields: [id_tarifario], references: [id_tarifario], onDelete: Cascade)
  createdAt    DateTime  @default(now()) @map("fecha_creacion")
  updatedAt    DateTime  @updatedAt @map("fecha_actualizacion")

  @@id([id_permiso, id_tarifario])
}

/// Empresas usuarias del sistema
model Empresa {
  id_empresa   Int                    @id @default(autoincrement()) @map("id_empresa") // ID único
  nombre       String                 @unique                                          // Nombre de la empresa
  laboratorios EmpresaOnLaboratorio[]                                                 // Relación con laboratorios
  tarifarios   Tarifario[]                                                            // Tarifarios asociados

  createdAt DateTime @default(now()) @map("fecha_creacion")
  updatedAt DateTime @updatedAt @map("fecha_actualizacion")
}

/// Relación muchos-a-muchos entre Empresas y Laboratorios
model EmpresaOnLaboratorio {
  id_empresa     Int         @map("empresa_id")
  id_laboratorio Int         @map("laboratorio_id")
  empresa        Empresa     @relation(fields: [id_empresa], references: [id_empresa], onDelete: Cascade)
  laboratorio    Laboratorio @relation(fields: [id_laboratorio], references: [id_laboratorio], onDelete: Cascade)
  createdAt      DateTime    @default(now()) @map("fecha_creacion")
  updatedAt      DateTime    @updatedAt @map("fecha_actualizacion")

  @@id([id_empresa, id_laboratorio])
}

/// Laboratorios que producen productos
model Laboratorio {
  id_laboratorio Int    @id @default(autoincrement()) @map("id_laboratorio") // ID del laboratorio
  nombre         String                                                   // Nombre del laboratorio

  productos Producto[]                                                   // Productos que fabrica
  empresas  EmpresaOnLaboratorio[]                                       // Empresas asociadas

  createdAt DateTime @default(now()) @map("fecha_creacion")
  updatedAt DateTime @updatedAt @map("fecha_actualizacion")
}

/// Entidades Promotoras de Salud (EPS)
model EPS {
  id_eps     Int         @id @default(autoincrement()) @map("id_eps") // ID único
  nombre     String      @unique                                      // Nombre de la EPS
  tarifarios Tarifario[]                                              // Tarifarios asociados

  createdAt DateTime @default(now()) @map("fecha_creacion")
  updatedAt DateTime @updatedAt @map("fecha_actualizacion")
}

/// Tarifarios de productos por EPS o Empresa
model Tarifario {
  id_tarifario Int                   @id @default(autoincrement()) @map("id_tarifario") // ID del tarifario
  nombre       String                @unique                                             // Nombre único
  id_eps       Int?                  @map("eps_id")                                     // ID de la EPS (opcional)
  id_empresa   Int?                  @map("empresa_id")                                 // ID de la empresa (opcional)
  eps          EPS?                  @relation(fields: [id_eps], references: [id_eps], onDelete: Cascade)
  empresa      Empresa?              @relation(fields: [id_empresa], references: [id_empresa], onDelete: Cascade)
  productos    TarifarioOnProducto[]                                                   // Productos incluidos
  permisos     PermisoOnTarifario[]                                                    // Permisos asociados

  createdAt DateTime @default(now()) @map("fecha_creacion")
  updatedAt DateTime @updatedAt @map("fecha_actualizacion")
}

/// Relación entre productos y tarifarios (precios definidos por tarifario)
model TarifarioOnProducto {
  id_tarifario   Int       @map("tarifario_id")
  id_producto    Int       @map("producto_id")
  precio         Int                                                   // Precio total del producto
  precio_unidad  Int                                                   // Precio por unidad
  precio_empaque Int                                                   // Precio por empaque
  tarifario      Tarifario @relation(fields: [id_tarifario], references: [id_tarifario], onDelete: Cascade)
  producto       Producto  @relation(fields: [id_producto], references: [id_producto], onDelete: Cascade)
  createdAt      DateTime  @default(now()) @map("fecha_creacion")
  updatedAt      DateTime  @updatedAt @map("fecha_actualizacion")

  @@id([id_tarifario, id_producto])
}

/// Productos registrados en el sistema
model Producto {
  id_producto         Int     @id @default(autoincrement()) @map("id_producto") // ID único
  cum                 String  @unique                                           // Código Único de Medicamento
  descripcion         String                                                   // Descripción del producto
  concentracion       String                                                   // Concentración del principio activo
  presentacion        String                                                   // Presentación del producto
  registro_sanitario  String  @unique                                          // Registro sanitario oficial
  id_laboratorio      Int     @map("laboratorio_id")                           // Laboratorio que lo produce
  precio_unidad       Decimal                                                  // Precio unitario
  precio_presentacion Decimal                                                  // Precio por presentación
  iva                 Decimal                                                  // Valor del IVA
  regulacion          String?                                                  // Régimen de regulación (si aplica)
  codigo_barras       String  @unique                                          // Código de barras único

  // Campos de inventario (RF003)
  stock_actual        Int     @default(0)                                      // Stock actual en inventario
  stock_minimo        Int     @default(0)                                      // Stock mínimo para alertas
  stock_maximo        Int?                                                     // Stock máximo (capacidad)
  unidad_medida       String  @default("unidad")                               // Unidad de medida (unidad, caja, blister, etc.)

  laboratorio         Laboratorio           @relation(fields: [id_laboratorio], references: [id_laboratorio])
  tarifarios          TarifarioOnProducto[]
  detalles_orden      DetalleOrdenCompra[]                                     // Detalles de órdenes de compra
  movimientos         MovimientoInventario[]                                   // Movimientos de inventario
  detalles_entrega    DetalleEntrega[]                                         // Detalles de entregas (RF008)

  createdAt          DateTime @default(now()) @map("fecha_creacion")
  updatedAt          DateTime @updatedAt @map("fecha_actualizacion")
}

/// Proveedores del sistema
model Proveedor {
  id_proveedor Int           @id @default(autoincrement()) @map("id_proveedor")
  nombre       String                                                        // Nombre del proveedor
  laboratorio  String?                                                       // Laboratorio asociado (opcional)
  tipo         String?                                                       // Tipo de proveedor
  titular      String?                                                       // Titular o contacto principal
  direccion    String?                                                       // Dirección física
  telefono     String?                                                       // Teléfono de contacto
  email        String?                                                       // Email de contacto
  nit          String?        @unique                                        // NIT/RUT del proveedor
  ciudad       String?                                                       // Ciudad
  pais         String?                                                       // País
  activo       Boolean        @default(true)                                 // Estado del proveedor
  notas        String?        @db.Text                                       // Notas adicionales
  transacciones Transaccion[]                                                // Historial de transacciones
  ordenes_compra OrdenCompra[]                                               // Órdenes de compra del proveedor

  creado_en    DateTime @default(now()) @map("creado_en")
  actualizado_en DateTime @updatedAt @map("actualizado_en")

  @@map("proveedores")
}

/// Transacciones de compras con proveedores
model Transaccion {
  id_transaccion      Int      @id @default(autoincrement()) @map("id_transaccion")
  id_proveedor        Int      @map("proveedor_id")
  tipo                String                                                     // "compra", "devolucion", "pago"
  concepto            String                                                     // Descripción de la transacción
  monto               Decimal                                                    // Monto de la transacción
  cantidad            Int?                                                       // Cantidad de productos (si aplica)
  numero_factura      String?                                                    // Número de factura
  fecha_emision       DateTime? @map("fecha_emision") @db.Date                  // Fecha de emisión
  fecha_vencimiento   DateTime? @map("fecha_vencimiento") @db.Date              // Fecha de vencimiento (si aplica)
  estado              String?   @default("pendiente")                           // "pendiente", "completada", "cancelada"
  notas               String?   @db.Text                                        // Notas adicionales
  fecha_creacion      DateTime  @default(now()) @map("fecha_creacion")          // Fecha de creación del registro
  fecha_actualizacion DateTime  @updatedAt @map("fecha_actualizacion")          // Fecha de actualización del registro

  proveedor           Proveedor @relation(fields: [id_proveedor], references: [id_proveedor], onDelete: Cascade)

  @@index([id_proveedor], map: "proveedor_id")
  @@map("transacciones")
}

/// Órdenes de compra a proveedores
model OrdenCompra {
  id_orden_compra       Int      @id @default(autoincrement()) @map("id_orden_compra")
  numero_orden          String   @unique @map("numero_orden")                   // Número de orden único (ej: OC-2024-0001)
  id_proveedor          Int      @map("proveedor_id")
  id_creado_por         Int      @map("creado_por")                            // Usuario que creó la orden
  id_aprobado_por       Int?     @map("aprobado_por")                          // Usuario que aprobó/rechazó la orden
  fecha_orden           DateTime @default(now()) @map("fecha_orden")           // Fecha de creación
  fecha_entrega_estimada DateTime? @map("fecha_entrega_estimada")              // Fecha estimada de entrega
  fecha_aprobacion      DateTime? @map("fecha_aprobacion")                     // Fecha de aprobación/rechazo
  estado                String   @default("pendiente")                         // "pendiente", "en_proceso", "aprobada", "rechazada", "completada", "cancelada"
  subtotal              Decimal  @default(0)                                   // Subtotal sin impuestos
  impuestos             Decimal  @default(0)                                   // Total de impuestos
  total                 Decimal  @default(0)                                   // Total de la orden
  notas                 String?  @db.Text                                      // Notas generales
  motivo_rechazo        String?  @db.Text                                      // Motivo de rechazo (si aplica)

  proveedor             Proveedor @relation(fields: [id_proveedor], references: [id_proveedor], onDelete: Cascade)
  creado_por            Usuario   @relation("OrdenesCreadas", fields: [id_creado_por], references: [id_usuario])
  aprobado_por          Usuario?  @relation("OrdenesAprobadas", fields: [id_aprobado_por], references: [id_usuario])
  detalles              DetalleOrdenCompra[]                                   // Detalles de productos
  movimientos_inventario MovimientoInventario[]                                // Movimientos de inventario asociados
  historial             HistorialOrdenCompra[]                                 // Historial de cambios de estado (RF004)

  creado_en             DateTime @default(now()) @map("creado_en")
  actualizado_en        DateTime @updatedAt @map("actualizado_en")

  @@map("ordenes_compra")
}

/// Detalle de productos en cada orden de compra
model DetalleOrdenCompra {
  id_detalle       Int      @id @default(autoincrement()) @map("id_detalle")
  id_orden_compra  Int      @map("orden_compra_id")
  id_producto      Int      @map("producto_id")
  cantidad         Int                                                          // Cantidad solicitada
  precio_unitario  Decimal                                                      // Precio unitario acordado
  subtotal         Decimal                                                      // Subtotal (cantidad * precio_unitario)

  orden_compra     OrdenCompra @relation(fields: [id_orden_compra], references: [id_orden_compra], onDelete: Cascade)
  producto         Producto    @relation(fields: [id_producto], references: [id_producto])

  creado_en        DateTime @default(now()) @map("creado_en")
  actualizado_en   DateTime @updatedAt @map("actualizado_en")

  @@map("detalles_orden_compra")
}

/// Movimientos de inventario (RF003)
model MovimientoInventario {
  id_movimiento    Int      @id @default(autoincrement()) @map("id_movimiento")
  id_producto      Int      @map("producto_id")
  tipo_movimiento  String                                                       // "entrada", "salida", "ajuste", "devolucion"
  cantidad         Int                                                          // Cantidad del movimiento (positivo o negativo)
  stock_anterior   Int                                                          // Stock antes del movimiento
  stock_nuevo      Int                                                          // Stock después del movimiento
  id_orden_compra  Int?     @map("orden_compra_id")                            // ID de orden de compra (si aplica)
  id_usuario       Int?     @map("usuario_id")                                 // Usuario que realizó el movimiento
  motivo           String?  @db.Text                                           // Descripción o motivo del movimiento
  numero_referencia String? @map("numero_referencia")                          // Número de factura, guía, etc.

  producto         Producto @relation(fields: [id_producto], references: [id_producto], onDelete: Cascade)
  usuario          Usuario? @relation(fields: [id_usuario], references: [id_usuario])
  orden_compra     OrdenCompra? @relation(fields: [id_orden_compra], references: [id_orden_compra])

  creado_en        DateTime @default(now()) @map("creado_en")

  @@map("movimientos_inventario")
}

/// Historial de cambios de estado en órdenes de compra (RF004)
model HistorialOrdenCompra {
  id_historial     Int      @id @default(autoincrement()) @map("id_historial")
  id_orden_compra  Int      @map("orden_compra_id")
  estado_anterior  String?                                                      // Estado previo (null si es creación)
  estado_nuevo     String                                                       // Nuevo estado
  tipo_cambio      String   @default("estado")                                 // "estado", "datos", "productos"
  id_usuario       Int?     @map("usuario_id")                                 // Usuario que realizó el cambio
  comentario       String?  @db.Text                                           // Comentario o motivo del cambio
  campos_modificados String? @db.Text                                          // JSON con detalles de campos modificados

  orden_compra     OrdenCompra @relation(fields: [id_orden_compra], references: [id_orden_compra], onDelete: Cascade)
  usuario          Usuario?    @relation(fields: [id_usuario], references: [id_usuario])

  creado_en        DateTime @default(now()) @map("creado_en")

  @@map("historial_ordenes_compra")
}

/// Pacientes/Clientes del sistema para entregas (RF007)
model Paciente {
  id_paciente       Int      @id @default(autoincrement()) @map("id_paciente")        // ID único del paciente
  tipo_identificacion String @db.VarChar(20)                                          // Tipo: CC, TI, CE, Pasaporte
  numero_identificacion String @unique                                                 // Número de identificación único
  nombres           String   @db.VarChar(100)                                         // Nombres del paciente
  apellidos         String   @db.VarChar(100)                                         // Apellidos del paciente
  fecha_nacimiento  DateTime?                                                          // Fecha de nacimiento
  genero            String?  @db.VarChar(20)                                          // Masculino, Femenino, Otro
  telefono_principal String  @db.VarChar(20)                                          // Teléfono principal
  telefono_secundario String? @db.VarChar(20)                                         // Teléfono secundario (opcional)
  email             String?  @db.VarChar(100)                                         // Email (opcional)

  // Dirección
  direccion         String   @db.VarChar(255)                                         // Dirección completa
  ciudad            String   @db.VarChar(100)                                         // Ciudad
  departamento      String   @db.VarChar(100)                                         // Departamento/Estado
  codigo_postal     String?  @db.VarChar(20)                                          // Código postal (opcional)
  barrio            String?  @db.VarChar(100)                                         // Barrio o zona

  // Información adicional
  eps               String?  @db.VarChar(100)                                         // EPS del paciente
  tipo_afiliacion   String?  @db.VarChar(50)                                          // Contributivo, Subsidiado, Particular
  observaciones     String?  @db.Text                                                 // Observaciones o notas adicionales
  activo            Boolean  @default(true)                                           // Si el paciente está activo

  // Relaciones
  entregas          Entrega[]                                                        // Entregas asociadas al paciente

  createdAt         DateTime @default(now()) @map("fecha_creacion")
  updatedAt         DateTime @updatedAt @map("fecha_actualizacion")

  @@map("pacientes")
  @@index([numero_identificacion])
  @@index([nombres, apellidos])
}

/// Pedidos de Entrega a Pacientes (RF008)
model Entrega {
  id_entrega               Int      @id @default(autoincrement()) @map("id_entrega")
  numero_pedido            String   @unique @db.VarChar(50)                          // Número único del pedido (ej: ENT-2024-0001)
  id_paciente              Int      @map("paciente_id")                              // Paciente que recibe la entrega

  // Fechas
  fecha_pedido             DateTime @default(now())                                  // Fecha de creación del pedido
  fecha_entrega_programada DateTime?                                                 // Fecha programada para la entrega
  fecha_entrega_real       DateTime?                                                 // Fecha real de entrega

  // Estado del pedido
  estado                   String   @db.VarChar(50) @default("Pendiente de Despacho") // Estados: Pendiente de Despacho, En Preparación, Despachado, Entregado, Cancelado

  // Dirección de entrega (puede ser diferente a la del paciente)
  direccion_entrega        String   @db.VarChar(255)
  ciudad_entrega           String   @db.VarChar(100)
  departamento_entrega     String   @db.VarChar(100)
  barrio_entrega           String?  @db.VarChar(100)
  observaciones_direccion  String?  @db.Text

  // Información adicional
  observaciones            String?  @db.Text                                         // Observaciones generales del pedido
  observaciones_despacho   String?  @db.Text                                         // Notas del despachador

  // Usuarios
  id_usuario_creador       Int      @map("usuario_creador_id")                       // Usuario que creó el pedido
  id_usuario_despachador   Int?     @map("usuario_despachador_id")                   // Usuario que despachó el pedido

  // Totales
  total                    Decimal  @db.Decimal(12, 2) @default(0.00)               // Total del pedido

  // Control
  activo                   Boolean  @default(true)                                   // Soft delete

  // Optimización de Rutas (RF009)
  id_ruta                  Int?     @map("ruta_id")                                  // Ruta a la que pertenece (opcional)
  orden_en_ruta            Int?                                                      // Orden de entrega dentro de la ruta

  // Prueba de Entrega Digital (RF010)
  firma_entrega            String?  @db.VarChar(255)                                 // Ruta del archivo de firma digital
  foto_entrega             String?  @db.VarChar(255)                                 // Ruta del archivo de foto de evidencia
  nombre_receptor          String?  @db.VarChar(200)                                 // Nombre de quien recibe
  identificacion_receptor  String?  @db.VarChar(50)                                  // Identificación de quien recibe
  observaciones_entrega    String?  @db.Text                                         // Observaciones del domiciliario al entregar
  fecha_confirmacion_entrega DateTime?                                               // Fecha/hora de confirmación de entrega

  // Relaciones
  paciente                 Paciente @relation(fields: [id_paciente], references: [id_paciente])
  usuario_creador          Usuario  @relation("EntregasCreadas", fields: [id_usuario_creador], references: [id_usuario])
  usuario_despachador      Usuario? @relation("EntregasDespachadas", fields: [id_usuario_despachador], references: [id_usuario])
  detalles                 DetalleEntrega[]                                          // Productos del pedido
  ruta                     Ruta?    @relation(fields: [id_ruta], references: [id_ruta])  // Ruta asignada (RF009)

  createdAt                DateTime @default(now()) @map("fecha_creacion")
  updatedAt                DateTime @updatedAt @map("fecha_actualizacion")

  @@map("entregas")
  @@index([numero_pedido])
  @@index([id_paciente])
  @@index([estado])
  @@index([fecha_pedido])
  @@index([id_ruta])
}

/// Detalle de productos en una entrega (RF008)
model DetalleEntrega {
  id_detalle_entrega  Int      @id @default(autoincrement()) @map("id_detalle_entrega")
  id_entrega          Int      @map("entrega_id")                                    // Entrega a la que pertenece
  id_producto         Int      @map("producto_id")                                   // Producto entregado

  cantidad            Int                                                             // Cantidad entregada
  precio_unitario     Decimal  @db.Decimal(10, 2)                                   // Precio unitario al momento de la entrega
  subtotal            Decimal  @db.Decimal(12, 2)                                   // Subtotal (cantidad * precio_unitario)

  observaciones       String?  @db.Text                                              // Observaciones del producto en esta entrega

  // Relaciones
  entrega             Entrega  @relation(fields: [id_entrega], references: [id_entrega], onDelete: Cascade)
  producto            Producto @relation(fields: [id_producto], references: [id_producto])

  createdAt           DateTime @default(now()) @map("fecha_creacion")
  updatedAt           DateTime @updatedAt @map("fecha_actualizacion")

  @@map("detalles_entrega")
  @@index([id_entrega])
  @@index([id_producto])
}

/// Domiciliarios/Repartidores del sistema (RF009)
model Domiciliario {
  id_domiciliario     Int      @id @default(autoincrement()) @map("id_domiciliario")
  nombres             String   @db.VarChar(100)                                        // Nombres del domiciliario
  apellidos           String   @db.VarChar(100)                                        // Apellidos del domiciliario
  numero_identificacion String @unique                                                  // Número de identificación único
  telefono            String   @db.VarChar(20)                                         // Teléfono de contacto
  email               String?  @db.VarChar(100)                                        // Email (opcional)

  // Información del vehículo
  tipo_vehiculo       String?  @db.VarChar(50)                                         // Tipo: Moto, Bicicleta, Auto, A pie
  placa_vehiculo      String?  @db.VarChar(20)                                         // Placa del vehículo (si aplica)

  // Estado
  activo              Boolean  @default(true)                                          // Si está activo
  disponible          Boolean  @default(true)                                          // Si está disponible para asignación

  // Seguimiento en Tiempo Real (RF010)
  latitud_actual      Decimal? @db.Decimal(10, 8)                                     // Latitud actual (GPS)
  longitud_actual     Decimal? @db.Decimal(11, 8)                                     // Longitud actual (GPS)
  ultima_actualizacion_ubicacion DateTime?                                            // Última actualización de ubicación

  // Observaciones
  observaciones       String?  @db.Text                                                // Observaciones adicionales

  // Relaciones
  rutas               Ruta[]                                                           // Rutas asignadas al domiciliario

  createdAt           DateTime @default(now()) @map("fecha_creacion")
  updatedAt           DateTime @updatedAt @map("fecha_actualizacion")

  @@map("domiciliarios")
  @@index([numero_identificacion])
  @@index([activo, disponible])
}

/// Rutas de Entrega Optimizadas (RF009)
model Ruta {
  id_ruta             Int      @id @default(autoincrement()) @map("id_ruta")
  numero_ruta         String   @unique @db.VarChar(50)                                 // Número único de ruta (ej: RUTA-2024-0001)

  // Asignación
  id_domiciliario     Int?     @map("domiciliario_id")                                 // Domiciliario asignado (opcional inicialmente)
  id_usuario_creador  Int      @map("usuario_creador_id")                              // Usuario que creó la ruta

  // Fechas
  fecha_creacion_ruta DateTime @default(now())                                         // Fecha de creación de la ruta
  fecha_programada    DateTime?                                                        // Fecha programada para ejecutar la ruta
  fecha_inicio        DateTime?                                                        // Fecha/hora de inicio real
  fecha_finalizacion  DateTime?                                                        // Fecha/hora de finalización

  // Estado
  estado              String   @db.VarChar(50) @default("Pendiente")                   // Estados: Pendiente, En Curso, Completada, Cancelada

  // Optimización
  distancia_total_km  Decimal? @db.Decimal(10, 2)                                     // Distancia total estimada en km
  tiempo_estimado_min Int?                                                             // Tiempo estimado en minutos

  // Observaciones
  observaciones       String?  @db.Text                                                // Observaciones de la ruta
  motivo_cancelacion  String?  @db.Text                                                // Motivo de cancelación (si aplica)

  // Control
  activo              Boolean  @default(true)                                          // Soft delete

  // Relaciones
  domiciliario        Domiciliario? @relation(fields: [id_domiciliario], references: [id_domiciliario])
  usuario_creador     Usuario  @relation("RutasCreadas", fields: [id_usuario_creador], references: [id_usuario])
  entregas            Entrega[]                                                        // Entregas incluidas en la ruta

  createdAt           DateTime @default(now()) @map("fecha_creacion")
  updatedAt           DateTime @updatedAt @map("fecha_actualizacion")

  @@map("rutas")
  @@index([numero_ruta])
  @@index([id_domiciliario])
  @@index([estado])
  @@index([fecha_programada])
}
